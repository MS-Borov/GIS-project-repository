POSTGRES_DB=gis_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080
AI_DIGITIZER_PORT=8790

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_HOST=redis
REDIS_PORT=6379

DB_HOST=postgres
DB_PORT=5432
DB_NAME=gis_platform
DB_USER=postgres
DB_PASSWORD=postgres

S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=submissions
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_USE_SSL=false

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_access

ENVIRONMENT=development
LOG_LEVEL=info

# === Backend: DB pool tuning ===
# Echo SQL queries to logs (verbose, для отладки). На проде держать false.
DB_ECHO=false
# Размер пула на 1 uvicorn-воркер. С 4 воркерами и pool_size=10 max_overflow=5
# получится до 60 коннектов к Postgres (дефолтный лимит Postgres = 100).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# === Backend: uvicorn runtime ===
# По умолчанию (пусто) запускается с --reload для dev-режима.
# Для production раскомментировать (число workers ~ количеству CPU ядер):
# UVICORN_EXTRA_ARGS=--workers 4 --timeout-keep-alive 30

# === Backend: upload size limits ===
# Жёсткие лимиты на загружаемые файлы. Backend кидает 413 если превышено.
# nginx client_max_body_size в dev.conf — независимый hard-cap (по умолчанию 110m).
MAX_DOCUMENT_UPLOAD_BYTES=31457280     # 30 MB — для DOCX/PDF (отчёты, методички)
MAX_ARCHIVE_UPLOAD_BYTES=104857600     # 100 MB — для ZIP-архивов сдач/материалов

# === Postgres backups ===
# Контейнер postgres-backup делает pg_dump каждые BACKUP_INTERVAL_HOURS,
# хранит файлы BACKUP_RETENTION_DAYS дней в ./backups/ на хосте.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7

# For LAN testing, open only the frontend URL and let Vite proxy /api to backend.
VITE_API_URL=/api

# One-time email verification for public student registration.
# Keep disabled for local development unless SMTP is configured.
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFICATION_CODE_TTL_MINUTES=20
# EMAIL_VERIFICATION_RESEND_SECONDS=60
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USERNAME=example@yandex.ru
# SMTP_PASSWORD=app-password
# SMTP_FROM_EMAIL=example@yandex.ru
# SMTP_FROM_NAME=GIS Education Platform
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# Gmail / Google Workspace example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=example@gmail.com
# SMTP_PASSWORD=google-app-password
# SMTP_FROM_EMAIL=example@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# Alternative Gmail SSL mode:
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
# For local debugging only: returns the code in API response.
# EMAIL_VERIFICATION_DEV_RETURN_CODE=false

# LLM report review. Use one multimodal backend for text + report screenshots.
# For free testing, create an OpenRouter key and keep a :free vision model.
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free fallback router. It can pick a free vision model automatically, but
# answers may be less reproducible than with a fixed model.
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
#
# Alternative free vision models to try if Gemma is rate-limited or weak on screenshots:
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# OPENROUTER_MODEL=google/gemma-3n-e4b-it:free

AI_DIGITIZER_URL=http://ai-digitizer:8790
AI_DIGITIZER_TIMEOUT_SECONDS=45
AI_DIGITIZER_BACKEND=prompt-ml
AI_DIGITIZER_DOCKERFILE=Dockerfile
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# To enable GeoSAM/SAM2, set:
# AI_DIGITIZER_BACKEND=geosam
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
#
# To enable two-stage water digitizing, set:
# AI_DIGITIZER_BACKEND=water-sam2
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
#
# To enable prompt-sampled local segmentation, set:
# AI_DIGITIZER_BACKEND=prompt-ml
#
# To enable prompt-sampled segmentation refined by SAM2, set:
# AI_DIGITIZER_BACKEND=prompt-ml-sam2
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
SAM2_REPO_PATH=/opt/sam2
SAM2_REPO_PATH_HOST=./ai-digitizer-service/vendor/sam2
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_CHECKPOINT=/models/sam2.1_hiera_tiny.pt
SAM2_DEVICE=auto
SAM2_MASK_PROMPT_SIZE=256
PROMPT_ML_BUFFER_RATIO=0.08
PROMPT_ML_BUFFER_MAX_PX=90
PROMPT_ML_NEGATIVE_RING_RATIO=0.22
PROMPT_ML_MAX_SAMPLES=6000
PROMPT_ML_POSITIVE_THRESHOLD_SCALE=1.45
PROMPT_ML_NEGATIVE_MARGIN=0.72
PROMPT_ML_MAX_AREA_RATIO=0.82
PROMPT_ML_SIMPLIFY_RATIO=0.0045
OSM_WATER_HEURISTIC_ENABLED=false
OSM_FILL_HEURISTIC_ENABLED=false
OSM_FOREST_HEURISTIC_ENABLED=false
OSM_WATER_MIN_PIXEL_RATIO=0.0008
OSM_WATER_MAX_AREA_RATIO=0.38
OSM_WATER_LARGE_PROMPT_RATIO=0.22
OSM_WATER_LARGE_MAX_AREA_RATIO=0.86
OSM_WATER_SIMPLIFY_RATIO=0.0035
OSM_WATER_LARGE_SIMPLIFY_RATIO=0.0008
OSM_FOREST_MIN_PIXEL_RATIO=0.0012
OSM_FOREST_MAX_AREA_RATIO=0.62
OSM_FOREST_LARGE_PROMPT_RATIO=0.24
OSM_FOREST_LARGE_MAX_AREA_RATIO=0.9
OSM_FOREST_SIMPLIFY_RATIO=0.0025
OSM_FOREST_LARGE_SIMPLIFY_RATIO=0.001
OSM_LOCAL_RF_ENABLED=true
OSM_LOCAL_RF_MAX_SAMPLES=9000
OSM_LOCAL_RF_MIN_POSITIVE=32
OSM_LOCAL_RF_MIN_COVERAGE=0.12
OSM_FILL_MIN_PIXEL_RATIO=0.0012
OSM_FILL_MAX_AREA_RATIO=0.62
OSM_FILL_SIMPLIFY_RATIO=0.004
SAM2_MAX_COARSE_AREA_RATIO=1.25
SAM2_MIN_COARSE_IOU=0.55
SAM2_MIN_COARSE_COVERAGE=0.72
WATER_UNET_CHECKPOINT=/models/water_unet.pt
WATER_UNET_DEVICE=auto
WATER_UNET_THRESHOLD=0.5
AI_PROMPT_BUFFER_RATIO=0.04
AI_PROMPT_BUFFER_MAX_PX=40
AI_MIN_RESULT_PROMPT_IOU=0.28
AI_MIN_PROMPT_COVERAGE=0.55
AI_MAX_RESULT_PROMPT_AREA_RATIO=1.8
AI_MODELS_DIR=./models
AI_DATASETS_DIR=./datasets
AI_EXPERIMENTS_DIR=./experiments
POSTGRES_DB=gis_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

BACKEND_PORT=8000
FRONTEND_PORT=5173
AI_DIGITIZER_PORT=8790

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_HOST=redis
REDIS_PORT=6379

DB_HOST=postgres
DB_PORT=5432
DB_NAME=gis_platform
DB_USER=postgres
DB_PASSWORD=postgres

S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=submissions
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_USE_SSL=false

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_access

ENVIRONMENT=development
LOG_LEVEL=info

VITE_API_URL=http://localhost:8000

AI_DIGITIZER_URL=http://ai-digitizer:8790
AI_DIGITIZER_TIMEOUT_SECONDS=45
AI_DIGITIZER_BACKEND=classical-cv
AI_DIGITIZER_DOCKERFILE=Dockerfile
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# To enable GeoSAM/SAM2, set:
# AI_DIGITIZER_BACKEND=geosam
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
#
# To enable two-stage water digitizing, set:
# AI_DIGITIZER_BACKEND=water-sam2
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
#
# To enable prompt-sampled local segmentation, set:
# AI_DIGITIZER_BACKEND=prompt-ml
#
# To enable prompt-sampled segmentation refined by SAM2, set:
# AI_DIGITIZER_BACKEND=prompt-ml-sam2
# AI_DIGITIZER_DOCKERFILE=Dockerfile.sam2
SAM2_REPO_PATH=/opt/sam2
SAM2_REPO_PATH_HOST=./ai-digitizer-service/vendor/sam2
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_CHECKPOINT=/models/sam2.1_hiera_tiny.pt
SAM2_DEVICE=auto
SAM2_MASK_PROMPT_SIZE=256
PROMPT_ML_BUFFER_RATIO=0.08
PROMPT_ML_BUFFER_MAX_PX=90
PROMPT_ML_NEGATIVE_RING_RATIO=0.22
PROMPT_ML_MAX_SAMPLES=6000
SAM2_MAX_COARSE_AREA_RATIO=1.25
SAM2_MIN_COARSE_IOU=0.55
SAM2_MIN_COARSE_COVERAGE=0.72
WATER_UNET_CHECKPOINT=/models/water_unet.pt
WATER_UNET_DEVICE=auto
WATER_UNET_THRESHOLD=0.5
AI_PROMPT_BUFFER_RATIO=0.04
AI_PROMPT_BUFFER_MAX_PX=40
AI_MIN_RESULT_PROMPT_IOU=0.28
AI_MIN_PROMPT_COVERAGE=0.55
AI_MAX_RESULT_PROMPT_AREA_RATIO=1.8
AI_MODELS_DIR=./models
AI_DATASETS_DIR=./datasets
AI_EXPERIMENTS_DIR=./experiments
